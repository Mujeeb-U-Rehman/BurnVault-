# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: PostgreSQL (if unset, SQLite is used)
DB_NAME=burnvault_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=
DB_PORT=5432

# Optional: Redis channel layer (if unset, in-memory channel layer is used)
REDIS_HOST=
REDIS_PORT=6379

# Expiry times (seconds)
MESSAGE_EXPIRY_TIME=3600
FILE_EXPIRY_TIME=86400
